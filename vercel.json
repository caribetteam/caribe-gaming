{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "angular"
    },
    "mp-backend": {
      "root": "server/mp-backend",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": 
      "/steam/:path*", 
      "destination": "https://store.steampowered.com/:path*" 
    },
    { "source": 
      "/webapi/:path*", 
      "destination": "https://api.steampowered.com/:path*" 
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "mp-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
